{
  "name": "ScanLog",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "ID du billet scann\u00e9"
    },
    "event_id": {
      "type": "string",
      "description": "ID de l'\u00e9v\u00e9nement"
    },
    "ticket_code": {
      "type": "string",
      "description": "Code du billet scann\u00e9"
    },
    "result": {
      "type": "string",
      "enum": [
        "success",
        "already_scanned",
        "invalid",
        "wrong_event"
      ],
      "description": "R\u00e9sultat du scan"
    },
    "scanned_by": {
      "type": "string",
      "description": "Email du scanner"
    }
  },
  "required": [
    "event_id",
    "ticket_code",
    "result"
  ]
}